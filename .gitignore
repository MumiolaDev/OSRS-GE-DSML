# Bytecode / caches
__pycache__/
*.py[cod]
*.pyo

# Entornos virtuales
venv/
.venv/
env/
osrs_env/

# Bases de datos locales (se regeneran con recolector.py)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Candado de instancia única del recolector (ver bloqueo.py) -- es estado
# del proceso vivo, no del proyecto
*.db.lock

# Modelos entrenados
models/
*.pkl

# Logs del recolector corriendo 24/7
logs/
*.log

# Config local de la app de escritorio (token de Telegram, ruta de DB) --
# nunca credenciales commiteadas, ver configuracion.py
config.json

# Jupyter
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
